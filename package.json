{
  "name": "@jwyxym/video-player",
  "version": "0.0.4",
  "description": "A Vue 3 video player with HLS, configurable playback rates, and custom controls.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check build-only build:types",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --build",
    "prepack": "npm run build"
  },
  "main": "./dist/video-player.cjs",
  "module": "./dist/video-player.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/video-player.js",
      "require": "./dist/video-player.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "hls.js": "^1.7.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
